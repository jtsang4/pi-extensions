{
  "name": "@jtsang/pi-extensions",
  "version": "0.1.0",
  "description": "An opinionated collection of extensions for Pi",
  "type": "module",
  "license": "MIT",
  "author": "jtsang4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtsang4/pi-extensions.git"
  },
  "homepage": "https://github.com/jtsang4/pi-extensions#readme",
  "bugs": {
    "url": "https://github.com/jtsang4/pi-extensions/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent"
  ],
  "files": [
    "extensions",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "pnpm pack --dry-run",
    "test": "node --test --experimental-strip-types tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.17.0",
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "^0.82.1",
    "@types/node": "^26.1.1",
    "typebox": "^1.3.8",
    "typescript": "^7.0.2"
  }
}
